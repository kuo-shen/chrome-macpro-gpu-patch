+angle::Result IOSurfaceSurfaceCGL::postBindTexImage(const gl::Context *context, GLuint textureID)
+{
+    if (mBoundTextureID == 0 || mBoundTextureID == textureID || mIOSurfaceTextureID == 0)
+    {
+        return angle::Result::Continue;
+    }
+
+    // TextureGL::releaseTexImage from a previously bound surface recreated the GL texture ID
+    // after our bindTexImage() ran; re-allocate and populate the new 2D texture ID.
+    StateManagerGL *stateManager = GetStateManagerGL(context);
+    const FunctionsGL *functions = GetFunctionsGL(context);
+    const auto &format           = kIOSurfaceFormats[mFormatIndex];
+
+    stateManager->bindBuffer(gl::BufferBinding::PixelUnpack, 0, context->isHardenedContext());
+    stateManager->bindTexture(gl::TextureType::_2D, textureID);
+    functions->texImage2D(GL_TEXTURE_2D, 0, format.tex2DInternalFormat, mWidth, mHeight, 0,
+                          format.nativeFormat, format.nativeType, nullptr);
+
+    mBoundTextureID = textureID;
+    mNeedsWriteBack = false;
+    mLastSeed       = IOSurfaceGetSeed(mIOSurface);
+    mLastGeneration = (mDisplay != nullptr) ? mDisplay->getIOSurfaceGeneration(mIOSurfaceKey) : 0;
+
+    blitBetweenTextures(context, /*rectTo2D=*/true);
+    stateManager->bindTexture(gl::TextureType::_2D, textureID);
+    return angle::Result::Continue;
+}
