+void IOSurfaceSurfaceCGL::blitBetweenTextures(const gl::Context *context, bool rectTo2D)
+{
+    const FunctionsGL *functions = GetFunctionsGL(context);
+    StateManagerGL *stateManager = GetStateManagerGL(context);
+
+    GLuint readFBO  = 0;
+    GLuint writeFBO = 0;
+    mDisplay->getIOSurfaceBlitFBOs(&readFBO, &writeFBO);
+
+    stateManager->setScissorTestEnabled(false);
+    stateManager->setColorMask(true, true, true, true);
+    stateManager->setFramebufferSRGBEnabled(context, false);
+
+    stateManager->bindFramebuffer(GL_READ_FRAMEBUFFER, readFBO);
+    stateManager->bindFramebuffer(GL_DRAW_FRAMEBUFFER, writeFBO);
+
+    const GLenum srcTarget = rectTo2D ? GL_TEXTURE_RECTANGLE : GL_TEXTURE_2D;
+    const GLenum dstTarget = rectTo2D ? GL_TEXTURE_2D : GL_TEXTURE_RECTANGLE;
+    const GLuint srcTex    = rectTo2D ? mIOSurfaceTextureID : mBoundTextureID;
+    const GLuint dstTex    = rectTo2D ? mBoundTextureID : mIOSurfaceTextureID;
+
+    functions->framebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, srcTarget, srcTex,
+                                    0);
+    functions->framebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, dstTarget, dstTex,
+                                    0);
+
+    functions->blitFramebuffer(0, 0, mWidth, mHeight, 0, 0, mWidth, mHeight, GL_COLOR_BUFFER_BIT,
+                               GL_NEAREST);
+
+    functions->framebufferTexture2D(GL_READ_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, srcTarget, 0, 0);
+    functions->framebufferTexture2D(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, dstTarget, 0, 0);
+}
