+void IOSurfaceSurfaceCGL::onTextureReleased(const gl::Context *context)
+{
+    syncToNativeSurfaceIfDirty(context);
+    if (mDisplay != nullptr)
+    {
+        mDisplay->unregisterIOSurface(this);
+    }
+    mBoundTextureID = 0;
+}
