+angle::Result SyncActiveNativeSurfacesBeforeDraw(const gl::Context *context,
+                                                 StateManagerGL *stateManager)
+{
+    const gl::State &glState                = context->getState();
+    const gl::ProgramExecutable *executable = glState.getProgramExecutable();
+    bool anySynced                          = false;
+
+    if (executable != nullptr)
+    {
+        const gl::ActiveTexturesCache &textures     = glState.getActiveTexturesCache();
+        const gl::ActiveTextureMask &activeTextures = executable->getActiveSamplersMask();
+        for (size_t textureUnitIndex : activeTextures)
+        {
+            gl::Texture *texture = textures[textureUnitIndex];
+            if (texture != nullptr)
+            {
+                egl::Surface *boundSurface = texture->getBoundSurface();
+                if (boundSurface != nullptr)
+                {
+                    if (GetImplAs<SurfaceGL>(boundSurface)->syncFromNativeSurfaceIfNeeded(context))
+                    {
+                        anySynced = true;
+                    }
+                }
+            }
+        }
+    }
+
+    // Also sync destination color attachments before drawing (for blending / scissored /
+    // partial-raster read-modify-write onto an IOSurface updated elsewhere).
+    const gl::Framebuffer *drawFBO = glState.getDrawFramebuffer();
+    if (drawFBO != nullptr && !drawFBO->isDefault())
+    {
+        for (const gl::FramebufferAttachment &attachment : drawFBO->getColorAttachments())
+        {
+            if (attachment.isAttached() && attachment.type() == GL_TEXTURE)
+            {
+                gl::Texture *texture = attachment.getTexture();
+                if (texture != nullptr)
+                {
+                    egl::Surface *boundSurface = texture->getBoundSurface();
+                    if (boundSurface != nullptr)
+                    {
+                        if (GetImplAs<SurfaceGL>(boundSurface)
+                                ->syncFromNativeSurfaceIfNeeded(context))
+                        {
+                            anySynced = true;
+                        }
+                    }
+                }
+            }
+        }
+    }
+
+    if (anySynced)
+    {
+        ANGLE_TRY(stateManager->syncState(context, gl::state::DirtyBits(),
+                                          gl::state::DirtyBits().set(),
+                                          gl::state::ExtendedDirtyBits(),
+                                          gl::state::ExtendedDirtyBits().set()));
+    }
+
+    return angle::Result::Continue;
+}
+
+void MarkDrawFramebufferNativeSurfacesDirty(const gl::State &glState)
+{
+    const gl::Framebuffer *drawFBO = glState.getDrawFramebuffer();
+    if (drawFBO == nullptr || drawFBO->isDefault())
+    {
+        return;
+    }
+    for (const gl::FramebufferAttachment &attachment : drawFBO->getColorAttachments())
+    {
+        if (attachment.isAttached() && attachment.type() == GL_TEXTURE)
+        {
+            gl::Texture *texture = attachment.getTexture();
+            if (texture != nullptr)
+            {
+                egl::Surface *boundSurface = texture->getBoundSurface();
+                if (boundSurface != nullptr)
+                {
+                    GetImplAs<SurfaceGL>(boundSurface)->markDirtyForNativeWriteBack();
+                }
+            }
+        }
+    }
+}
