 egl::Error IOSurfaceSurfaceCGL::releaseTexImage(const gl::Context *context, EGLint buffer)
 {
+    onTextureReleased(context);
+
     const FunctionsGL *functions = GetFunctionsGL(context);
     functions->flush();
     return egl::NoError();
 }
 
+bool IOSurfaceSurfaceCGL::syncFromNativeSurfaceIfNeeded(const gl::Context *context)
+{
+    if (mBoundTextureID == 0 || mIOSurfaceTextureID == 0 || mIOSurface == nullptr)
+    {
+        return false;
+    }
+
+    // Never overwrite uncommitted GPU writes in mBoundTextureID with stale IOSurface pixels.
+    if (mNeedsWriteBack)
+    {
+        return false;
+    }
+
+    if (mDisplay != nullptr)
+    {
+        mDisplay->flushDirtyIOSurfaceByKey(context, mIOSurfaceKey, this);
+    }
+
+    uint32_t currentSeed = IOSurfaceGetSeed(mIOSurface);
+    uint64_t currentGen =
+        (mDisplay != nullptr) ? mDisplay->getIOSurfaceGeneration(mIOSurfaceKey) : 0;
+    if (currentSeed == mLastSeed && currentGen == mLastGeneration)
+    {
+        return false;
+    }
+
+    if (bindIOSurfaceToRectTexture(context, mIOSurfaceTextureID).isError())
+    {
+        return false;
+    }
+
+    blitBetweenTextures(context, /*rectTo2D=*/true);
+    mLastSeed       = currentSeed;
+    mLastGeneration = currentGen;
+    return true;
+}
+
+void IOSurfaceSurfaceCGL::markDirtyForNativeWriteBack()
+{
+    if (mBoundTextureID != 0 && mIOSurfaceTextureID != 0 && !mNeedsWriteBack)
+    {
+        mNeedsWriteBack = true;
+        if (mDisplay != nullptr)
+        {
+            mDisplay->markIOSurfaceDirty(this);
+        }
+    }
+}
+
+void IOSurfaceSurfaceCGL::syncToNativeSurfaceIfDirty(const gl::Context *context)
+{
+    if (!mNeedsWriteBack || mBoundTextureID == 0 || mIOSurfaceTextureID == 0 ||
+        mIOSurface == nullptr)
+    {
+        mNeedsWriteBack = false;
+        return;
+    }
+
+    mNeedsWriteBack = false;
+    blitBetweenTextures(context, /*rectTo2D=*/false);
+    mLastGeneration =
+        (mDisplay != nullptr) ? mDisplay->bumpIOSurfaceGeneration(mIOSurfaceKey) : mLastGeneration;
+    mLastSeed = IOSurfaceGetSeed(mIOSurface);
+}
