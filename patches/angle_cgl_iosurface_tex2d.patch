+egl::Error IOSurfaceSurfaceCGL::bindIOSurfaceToRectTexture(const gl::Context *context,
+                                                           GLuint rectTextureID)
+{
+    StateManagerGL *stateManager = GetStateManagerGL(context);
+    const FunctionsGL *functions = GetFunctionsGL(context);
+
+    stateManager->bindTexture(gl::TextureType::Rectangle, rectTextureID);
+    functions->texParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MIN_FILTER, GL_NEAREST);
+    functions->texParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_MAG_FILTER, GL_NEAREST);
+    functions->texParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+    functions->texParameteri(GL_TEXTURE_RECTANGLE, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+
+    const auto &format  = kIOSurfaceFormats[mFormatIndex];
+    GLenum nativeFormat = format.nativeFormat;
+    GLenum nativeType   = format.nativeType;
+
+    if (format.internalFormat == GL_RGB || format.internalFormat == GL_RGBA)
+    {
+        OSType pixelFormat = IOSurfaceGetPixelFormat(mIOSurface);
+        if (pixelFormat == 'RGBA')
+        {
+            nativeFormat = GL_RGBA;
+            nativeType   = GL_UNSIGNED_BYTE;
+        }
+        else if (pixelFormat == 'BGRA')
+        {
+            nativeFormat = GL_BGRA;
+            nativeType   = GL_UNSIGNED_INT_8_8_8_8_REV;
+        }
+    }
+
+    CGLError error = CGLTexImageIOSurface2D(mCGLContext, GL_TEXTURE_RECTANGLE,
+                                            format.nativeInternalFormat, mWidth, mHeight,
+                                            nativeFormat, nativeType, mIOSurface, mPlane);
+    if (error != kCGLNoError)
+    {
+        std::ostringstream err;
+        err << "CGLTexImageIOSurface2D failed: " << CGLErrorString(error);
+        return egl::Error(EGL_CONTEXT_LOST, err.str());
+    }
+    return egl::NoError();
+}
