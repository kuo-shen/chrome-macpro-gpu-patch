+
+void DisplayCGL::markIOSurfaceDirty(IOSurfaceSurfaceCGL *surface)
+{
+    if (surface != nullptr)
+    {
+        mDirtyIOSurfaces.insert(surface);
+    }
+}
+
+void DisplayCGL::unregisterIOSurface(IOSurfaceSurfaceCGL *surface)
+{
+    mDirtyIOSurfaces.erase(surface);
+}
+
+void DisplayCGL::flushDirtyIOSurfaces(const gl::Context *context)
+{
+    if (mDirtyIOSurfaces.empty() || context == nullptr)
+    {
+        return;
+    }
+
+    std::vector<IOSurfaceSurfaceCGL *> dirty(mDirtyIOSurfaces.begin(), mDirtyIOSurfaces.end());
+    mDirtyIOSurfaces.clear();
+    for (IOSurfaceSurfaceCGL *surface : dirty)
+    {
+        surface->syncToNativeSurfaceIfDirty(context);
+    }
+}
+
+void DisplayCGL::flushDirtyIOSurfaceByKey(const gl::Context *context,
+                                          uint64_t ioSurfaceKey,
+                                          const IOSurfaceSurfaceCGL *exclude)
+{
+    if (mDirtyIOSurfaces.empty() || context == nullptr)
+    {
+        return;
+    }
+
+    std::vector<IOSurfaceSurfaceCGL *> matching;
+    for (IOSurfaceSurfaceCGL *surface : mDirtyIOSurfaces)
+    {
+        if (surface != exclude && surface->getIOSurfaceKey() == ioSurfaceKey)
+        {
+            matching.push_back(surface);
+        }
+    }
+    for (IOSurfaceSurfaceCGL *surface : matching)
+    {
+        mDirtyIOSurfaces.erase(surface);
+        surface->syncToNativeSurfaceIfDirty(context);
+    }
+}
+
+uint64_t DisplayCGL::getIOSurfaceGeneration(uint64_t ioSurfaceKey) const
+{
+    auto it = mIOSurfaceGenerations.find(ioSurfaceKey);
+    return (it != mIOSurfaceGenerations.end()) ? it->second : 0;
+}
+
+uint64_t DisplayCGL::bumpIOSurfaceGeneration(uint64_t ioSurfaceKey)
+{
+    return ++mIOSurfaceGenerations[ioSurfaceKey];
